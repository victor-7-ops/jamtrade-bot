# ── Secrets & live configs ─────────────────────────────────────────────
# NEVER commit API keys or any live-trading config.
*secret*
*api_key*
config-live.json
config-prod.json
.env
.env.*

# ── Freqtrade runtime artifacts ────────────────────────────────────────
# NOTE: gitignore has NO inline comments. A trailing "# ..." becomes part of
# the pattern and silently matches nothing. Keep every comment on its own line.
# downloaded OHLCV (large, re-downloadable)
user_data/data/
user_data/backtest_results/
user_data/hyperopt_results/
user_data/logs/
user_data/plot/
# the trade database (incl. dry-run)
user_data/tradesv3.sqlite*
# trade DB at repo root (dry-run journal/WAL/SHM) — own line; inline # is not a comment
tradesv3*.sqlite*
*.log

# ── Python ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# ── OS / editor ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# uv-managed local toolchain
.python-version
