{
    "$schema": "https://schema.freqtrade.io/schema.json",

    "//  ───────────────────────────────────────────────────────────────": "",
    "//  DRY-RUN CONFIG — PAPER TRADING ON A LIVE FEED, NO REAL MONEY": "",
    "//  dry_run is TRUE. The bot connects to the real Kraken price feed": "",
    "//  but every trade is simulated against a fake wallet. This is the": "",
    "//  safe way to 'try it in the real market'. Leave dry_run TRUE until": "",
    "//  you have weeks/months of consistent results.": "",
    "//  ───────────────────────────────────────────────────────────────": "",

    "dry_run": true,
    "dry_run_wallet": 1000,

    "max_open_trades": 3,
    "stake_currency": "USDT",
    "stake_amount": 100,
    "tradable_balance_ratio": 0.99,
    "fiat_display_currency": "USD",
    "timeframe": "4h",

    "//  Pinned trading fee — REQUIRED, not cosmetic.": "",
    "//  ccxt 4.5.59 returns taker=None and maker=None on Kraken's per-market": "",
    "//  data (verified live on the EC2 box against BTC/USDT and LINK/USDT).": "",
    "//  Freqtrade reads that per-market value, so simulating any order does": "",
    "//  `cost * None` and dies with:": "",
    "//      TypeError: unsupported operand type(s) for *: 'float' and 'NoneType'": "",
    "//      at exchange.py add_dry_order_fee": "",
    "//  Entries survive because they are limit orders; the crash hits on the": "",
    "//  first market order, i.e. a stoploss exit — so the bot runs happily for": "",
    "//  days and then dies the moment it needs to exit a position.": "",
    "//  0.0026 is Kraken's own lowest-tier spot TAKER rate (their maker rate": "",
    "//  is 0.0016); ccxt still reports both at the exchange level even though": "",
    "//  the per-market fields are empty. Pinning it also makes dry-run results": "",
    "//  reproducible instead of varying with exchange metadata.": "",
    "fee": 0.0026,

    "cancel_open_orders_on_exit": false,
    "trading_mode": "spot",
    "margin_mode": "",

    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },

    "entry_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },

    "exit_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },

    "exchange": {
        "//  No API keys are needed for dry-run with public data.": "",
        "//  When you eventually go live, you'd add key/secret here AND": "",
        "//  flip dry_run to false — but not before paper trading.": "",
        "name": "kraken",
        "key": "",
        "secret": "",
        "ccxt_config": {},
        "ccxt_async_config": {},
        "pair_whitelist": [
            "BTC/USDT",
            "ETH/USDT",
            "SOL/USDT",
            "ADA/USDT",
            "XRP/USDT",
            "LINK/USDT",
            "DOT/USDT",
            "AVAX/USDT"
        ],
        "pair_blacklist": [
            "BNB/.*",
            ".*UP/USDT",
            ".*DOWN/USDT",
            ".*BULL/USDT",
            ".*BEAR/USDT"
        ]
    },

    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],

    "//  Telegram is OPTIONAL and is configured ENTIRELY VIA ENVIRONMENT.": "",
    "//  Freqtrade does NOT expand ${VAR} placeholders inside this file — a": "",
    "//  literal \"${TG_TOKEN}\" here fails at startup. Secrets must never be": "",
    "//  committed, so this file ships disabled and empty. To turn alerts on,": "",
    "//  export these three (e.g. from a chmod-600 .env via systemd": "",
    "//  EnvironmentFile) before starting the bot:": "",
    "//      FREQTRADE__TELEGRAM__ENABLED=true": "",
    "//      FREQTRADE__TELEGRAM__TOKEN=<BotFather token>": "",
    "//      FREQTRADE__TELEGRAM__CHAT_ID=<your chat id>": "",
    "//  Freqtrade merges FREQTRADE__-prefixed vars over this file before": "",
    "//  validating it. See docs/TELEGRAM-ALERTS.md.": "",
    "telegram": {
        "enabled": false,
        "token": "",
        "chat_id": ""
    },

    "//  The REST API + web UI is INTENTIONALLY ABSENT from this file.": "",
    "//": "",
    "//  It cannot be expressed here safely. Freqtrade's schema marks the": "",
    "//  whole api_server block required-if-present — [enabled,": "",
    "//  listen_ip_address, listen_port, username, password, jwt_secret_key]": "",
    "//  — and enforces minLength:32 on jwt_secret_key EVEN WHEN enabled is": "",
    "//  false (verified against freqtrade 2026.8). So a disabled block still": "",
    "//  demands real credentials, and this file is tracked by git, meaning": "",
    "//  any credential written here is published. Omitting the block is the": "",
    "//  only way to have no secrets and a valid config.": "",
    "//": "",
    "//  A previous version of this file committed a live jwt_secret_key and": "",
    "//  ws_token to the repo. Those values are burned — they are in git": "",
    "//  history forever. Generate new ones if you ever enable this.": "",
    "//": "",
    "//  To enable, set ALL of these together (partial env vars recreate the": "",
    "//  block without its required keys and fail validation):": "",
    "//      FREQTRADE__API_SERVER__ENABLED=true": "",
    "//      FREQTRADE__API_SERVER__LISTEN_IP_ADDRESS=127.0.0.1": "",
    "//      FREQTRADE__API_SERVER__LISTEN_PORT=8080": "",
    "//      FREQTRADE__API_SERVER__USERNAME=<pick one>": "",
    "//      FREQTRADE__API_SERVER__PASSWORD=<pick a strong one>": "",
    "//      FREQTRADE__API_SERVER__JWT_SECRET_KEY=<openssl rand -hex 32>": "",
    "//  Bind to 127.0.0.1 and reach it over an SSH tunnel. Do not open a port.": "",

    "bot_name": "StrategyLab-DryRun",
    "initial_state": "running",
    "force_entry_enable": false,

    "internals": {
        "process_throttle_secs": 5
    }
}
